{
    "name": "sc-library-backend",
    "version": "0.0.1",
    "description": "An express application for the South Church Library catalog",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "firebase-admin": "^14.5.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.4",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild": false,
        "@firebase/util@1.15.3": true,
        "protobufjs@7.6.6": true
    }
}

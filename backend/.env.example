PORT=8080
ALLOWED_ORIGINS=https://library.southchurch.com,http://localhost:5173
# Use these only when running against the Firebase emulators.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Google Workspace SMTP relay used to send email.
SMTP_CONNECTION_URI=
# Inject this value from Secret Manager in deployed environments.
SMTP_PASSWORD=
MAIL_COLLECTION=mail
